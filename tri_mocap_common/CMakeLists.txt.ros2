cmake_minimum_required(VERSION 3.28...4.2)
project(tri_mocap_common VERSION 0.0.0 LANGUAGES C CXX)

include(CheckIPOSupported)
include(GNUInstallDirs)

find_package(ament_cmake REQUIRED)

find_package(geometry_msgs REQUIRED)
find_package(rclcpp REQUIRED)
find_package(rclcpp_components REQUIRED)
find_package(rosidl_default_generators REQUIRED)
find_package(std_msgs REQUIRED)
find_package(tf2_msgs REQUIRED)

rosidl_generate_interfaces(${PROJECT_NAME}_msgs
  msg/MocapMarker.msg
  msg/MocapMarkerArray.msg
  msg/MocapObject.msg
  msg/MocapSegment.msg
  msg/MocapState.msg
  DEPENDENCIES geometry_msgs std_msgs)
rosidl_get_typesupport_target(msgs_cpp
  ${PROJECT_NAME}_msgs rosidl_typesupport_cpp)

# Defaults when this project is built on its own, as colcon does. A parent
# project or the command line can override them.
if(PROJECT_IS_TOP_LEVEL)
  if(NOT CMAKE_BUILD_TYPE AND NOT CMAKE_CONFIGURATION_TYPES)
    set(CMAKE_BUILD_TYPE RelWithDebInfo CACHE STRING "Build type" FORCE)
  endif()
  if(NOT DEFINED CMAKE_COMPILE_WARNING_AS_ERROR)
    set(CMAKE_COMPILE_WARNING_AS_ERROR ON)
  endif()
  if(NOT DEFINED CMAKE_INTERPROCEDURAL_OPTIMIZATION)
    check_ipo_supported(RESULT ipo_supported)
    set(CMAKE_INTERPROCEDURAL_OPTIMIZATION ${ipo_supported})
  endif()
endif()

# Flags for this project's own targets only; consumers don't inherit them.
add_library(${PROJECT_NAME}_compile_options INTERFACE)
set(${PROJECT_NAME}_warning_flags
  -Wall -Wextra -Wconversion -Wshadow -Wold-style-cast -Wpessimizing-move
  -Wuninitialized -Werror=non-virtual-dtor)
target_compile_options(${PROJECT_NAME}_compile_options INTERFACE
  "$<$<COMPILE_LANG_AND_ID:CXX,GNU,Clang,AppleClang>:${${PROJECT_NAME}_warning_flags}>")

# We don't depend on Drake, but we do use different build flags if present.
find_package(drake QUIET)
if(drake_FOUND)
  message(STATUS "Drake found, disabling -march=native")
else()
  message(STATUS "Drake NOT found, enabling -march=native")
  target_compile_options(${PROJECT_NAME}_compile_options INTERFACE
    $<$<COMPILE_LANGUAGE:CXX>:-march=native>)
endif()

# ROS node(s), as components and as standalone executables.
add_library(${PROJECT_NAME}_components SHARED
  src/mocap_tf_publisher_node.ros2.cpp)
target_include_directories(${PROJECT_NAME}_components PUBLIC
  $<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/src>)
target_compile_features(${PROJECT_NAME}_components PUBLIC cxx_std_17)
target_link_libraries(${PROJECT_NAME}_components
  PUBLIC
    rclcpp::rclcpp
    ${tf2_msgs_TARGETS}
    ${msgs_cpp}
  PRIVATE
    rclcpp_components::component
    $<BUILD_INTERFACE:${PROJECT_NAME}_compile_options>)
rclcpp_components_register_nodes(${PROJECT_NAME}_components
  "tri_mocap_common::MocapTFPublisherNode")

add_executable(${PROJECT_NAME}_node
  src/mocap_tf_publisher_node_main.ros2.cpp)
target_link_libraries(${PROJECT_NAME}_node
  PRIVATE ${PROJECT_NAME}_components ${PROJECT_NAME}_compile_options)

install(TARGETS ${PROJECT_NAME}_components)
install(TARGETS ${PROJECT_NAME}_node
  RUNTIME DESTINATION ${CMAKE_INSTALL_LIBDIR}/${PROJECT_NAME})

ament_package()
